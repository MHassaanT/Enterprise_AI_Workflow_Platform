# -----------------------------------------------------------------------------
# Enterprise AI Workflow Platform - Environment Configuration Example
# Copy this file to .env and configure appropriate values for your environment.
# -----------------------------------------------------------------------------

# --- General System Ports ---
PORT=4000
AGENT_PORT=8000
FRONTEND_PORT=3000

# --- PostgreSQL Configuration ---
POSTGRES_USER=hassan
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ai_platform
DATABASE_URL=postgresql://hassan:your_postgres_password_here@localhost:5432/ai_platform

# --- Security & Auth ---
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_TOKEN=internal_secret_change_in_production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Service URLs ---
BACKEND_URL=http://localhost:4000
AGENT_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks

# --- LLM & Embedding Gateways ---
# LLM Provider options: openrouter | gemini | ollama
LLM_PROVIDER=gemini

# Google Gemini API Config
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_DIMENSION=768

# OpenRouter (Optional fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama (Local LLM fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- SDR & Data Discovery APIs ---
SERPER_API_KEY=your_serper_api_key_here
ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here
HUNTER_IO_API_KEY=your_hunter_io_api_key_here
EMAILABLE_API_KEY=your_emailable_api_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here
GITHUB_TOKEN=your_github_personal_access_token_here

# --- Firebase (Email Verification) ---
# Choose ONE of the following options:

# Option A (Recommended): Base64 encoded service account JSON
# To generate: `cat firebase-service-account.json | base64 -w 0` (Linux/Mac)
FIREBASE_BASE64_SERVICE_ACCOUNT=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCiAg...

# Option B: Path to service account JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Option C: Individual credentials
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Paddle Billing (Merchant of Record) ---
# Backend API key (from Paddle Dashboard → Developer Tools → Authentication)
PADDLE_API_KEY=pdl_your_paddle_api_key
# Webhook secret (from Paddle Dashboard → Notifications → Destination secret)
PADDLE_WEBHOOK_SECRET=pdl_ntfsec_your_webhook_secret
# Environment: 'sandbox' for development, 'production' for live
PADDLE_ENVIRONMENT=sandbox

# Paddle Price IDs (create these in Paddle Dashboard → Catalog)
PADDLE_PRICE_ID_BASIC=pri_basic_plan_price_id
PADDLE_PRICE_ID_PRO=pri_pro_plan_price_id
PADDLE_PRICE_ID_ENTERPRISE=pri_enterprise_plan_price_id

# --- Paddle Frontend (safe to expose - client-side token) ---
# These go in frontend/.env.local as NEXT_PUBLIC_ prefixed vars
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token
NEXT_PUBLIC_PADDLE_ENVIRONMENT=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID_BASIC=pri_basic_plan_price_id
NEXT_PUBLIC_PADDLE_PRICE_ID_PRO=pri_pro_plan_price_id
NEXT_PUBLIC_PADDLE_PRICE_ID_ENTERPRISE=pri_enterprise_plan_price_id
